@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Forgot password confirmation";
}
@section Styles {
    <link rel="stylesheet" href="~/css/account/forgot-password-pages.css" asp-append-version="true" />
}

<div class="rw-auth-card">
    <div class="rw-auth-icon">📬</div>
    <h2 class="rw-auth-title">Check your inbox</h2>
    <p class="rw-auth-message">
        If an account exists for that email, we've sent a link to reset your password.
        Please check your inbox and follow the instructions.
    </p>
    <a asp-area="Identity" asp-page="/Account/Login" class="rw-auth-link">← Back to log in</a>
</div>