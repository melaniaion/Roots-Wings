@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="rw-manage-wrap">
    <header class="rw-manage-header">
        <h1 class="rw-page-title">Manage your account</h1>
        <p class="rw-manage-subtitle">Update your profile, security and account settings.</p>
    </header>

    <partial name="_ManageNav" />

    <div class="rw-manage-panel">
        @RenderBody()
    </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}

@section Styles {
    @RenderSection("Styles", required: false)
}