@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

@section Styles {
    <link rel="stylesheet" href="~/css/account/manage-account.css" asp-append-version="true" />
}

<form id="change-password-form" method="post" class="rw-account-form">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

    <div class="rw-field">
        <label asp-for="Input.OldPassword" class="rw-field-label"></label>
        <input asp-for="Input.OldPassword" class="rw-input" type="password" autocomplete="current-password" aria-required="true" placeholder="Current password" />
        <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
    </div>


    <div class="rw-field">
        <label asp-for="Input.NewPassword" class="rw-field-label"></label>
        <input asp-for="Input.NewPassword" class="rw-input" type="password" autocomplete="new-password" aria-required="true" placeholder="New password" />
        <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
        <p class="rw-field-hint">At least 6 characters, including one uppercase letter, one number and one symbol.</p>
    </div>

    <div class="rw-field">
        <label asp-for="Input.ConfirmPassword" class="rw-field-label"></label>
        <input asp-for="Input.ConfirmPassword" class="rw-input" type="password" autocomplete="new-password" aria-required="true" placeholder="Confirm new password" />
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
    </div>

    <button type="submit" class="btn-rw-primary">Update password</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}