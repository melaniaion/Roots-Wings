@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Reset password";
}
@section Styles {
    <link rel="stylesheet" href="~/css/account/forgot-password-pages.css" asp-append-version="true" />
}

<div class="rw-auth-card">
    <h2 class="rw-auth-title">Reset your password</h2>
    <p class="rw-auth-subtitle">Choose a new password for your account.</p>

    <form method="post" class="rw-auth-form">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

        <input asp-for="Input.Code" type="hidden" />
        <input asp-for="Input.Email" type="hidden" />

        <div class="rw-field">
            <label asp-for="Input.Password" class="rw-field-label">New password</label>
            <input asp-for="Input.Password" class="rw-input" type="password" autocomplete="new-password" aria-required="true" placeholder="New password" />
            <span asp-validation-for="Input.Password" class="text-danger"></span>
            <p class="rw-field-hint">At least 6 characters, including one uppercase letter, one number and one symbol.</p>
        </div>

        <div class="rw-field">
            <label asp-for="Input.ConfirmPassword" class="rw-field-label">Confirm password</label>
            <input asp-for="Input.ConfirmPassword" class="rw-input" type="password" autocomplete="new-password" aria-required="true" placeholder="Confirm new password" />
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
        </div>

        <button type="submit" class="btn-rw-primary w-100">Reset password</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}