@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password?";
}
@section Styles {
    <link rel="stylesheet" href="~/css/account/forgot-password-pages.css" asp-append-version="true" />
}

<div class="rw-auth-card">
    <h2 class="rw-auth-title">Forgot your password?</h2>
    <p class="rw-auth-subtitle">Enter your email and we'll send you a reset link.</p>

    <form method="post" class="rw-auth-form">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

        <div class="rw-field">
            <label asp-for="Input.Email" class="rw-field-label">Email</label>
            <input asp-for="Input.Email" class="rw-input" autocomplete="username" aria-required="true" placeholder="name@example.com" />
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>

        <button type="submit" class="btn-rw-primary w-100">Send reset link</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}