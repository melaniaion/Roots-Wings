@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Reset password confirmation";
}
@section Styles {
    <link rel="stylesheet" href="~/css/account/forgot-password-pages.css" asp-append-version="true" />
}

<div class="rw-auth-card">
    <h2 class="rw-auth-title">Password reset</h2>
    <p class="rw-auth-message">
        Your password has been reset successfully. You can now log in with your new password.
    </p>
    <a asp-area="Identity" asp-page="/Account/Login" class="rw-auth-link">Go to log in</a>
</div>