@model Roots_Wings.Models.JournalEntry

@{
    ViewData["Title"] = "Edit Entry";
    var allTags = ViewBag.AllTags as List<Roots_Wings.Models.Tag> ?? new List<Roots_Wings.Models.Tag>();
    var selectedTagIds = ViewBag.SelectedTagIds as List<int> ?? new List<int>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/journal.css" asp-append-version="true" />
}

<div class="journal-create-page">

    <a asp-action="Details" asp-route-id="@Model.Id" class="journal-back-link">
        ← Back to Entry
    </a>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" id="journalForm" class="journal-writing-form">
        @Html.AntiForgeryToken()

        @* Error zone at the top fold *@
        <div id="topErrorBlock" class="journal-error-summary" style="display:none;">
            <div class="title-header">Please check the following before saving changes:</div>
            <div asp-validation-summary="All" id="validationSummaryContainer"></div>
        </div>

        <div class="journal-open-page">

            <!-- Maintain original entry creation timestamp alignment -->
            <div class="journal-page-date">
                @Model.CreatedAt.ToString("MMMM dd, yyyy")
            </div>

            @* STICKERS *@
            @if (allTags.Any())
            {
                <div class="journal-feelings-section" id="feelingsSection">
                    <div class="tag-flow-header" id="tagFlowHeader">
                        <div class="tag-flow-title">
                            Index of Feelings <span class="active-tags-summary" id="tagsSummary"></span>
                        </div>
                        <span class="tag-flow-arrow">▼</span>
                    </div>
                    
                    <div class="journal-tags-pile" id="tagsPile">
                        <div class="journal-tags-container">
                            @foreach (var tag in allTags)
                            {
                                bool isChecked = selectedTagIds.Contains(tag.Id);
                                <div class="journal-tag-option">
                                    <input type="checkbox"
                                           name="selectedTagIds"
                                           value="@tag.Id"
                                           id="tag-@tag.Id"
                                           data-tagname="@tag.Name"
                                           class="tag-checkbox"
                                    @(isChecked ? "checked" : "") />
                                    <label for="tag-@tag.Id">@tag.Name</label>
                                </div>
                            }
                        </div>
                        <div class="close-drawer-container">
                            <button type="button" class="close-drawer-btn" id="closeDrawerBtn">Close Drawer</button>
                        </div>
                    </div>
                </div>
            }

            <div class="journal-field-group">
                <input asp-for="Title"
                       class="journal-writing-title"
                       placeholder="Give your entry a title..."
                       autocomplete="off" />
                <span asp-validation-for="Title"></span>
            </div>

            <div class="journal-writing-divider"></div>

            <div class="journal-field-group">
                <textarea asp-for="Content"
                          class="journal-writing-content"
                          placeholder="Write whatever is on your mind..."></textarea>
                <span asp-validation-for="Content"></span>
            </div>

        </div>

        <!--  ACTIONS -->
        <div class="journal-actions">
            <button type="submit" class="journal-save-button">
                Save Changes
            </button>

            <button type="button" class="journal-discard-button" id="openDiscardModalBtn">
                Discard Changes
            </button>
        </div>

    </form>
</div>

@* IN-APP CONFIRMATION POP-UP MODAL *@
<div class="journal-modal-overlay" id="discardModal">
    <div class="journal-modal-card">
        <div class="journal-modal-title">Discard Changes?</div>
        <div class="journal-modal-text">
            Are you sure you want to cancel editing? Any modifications or edits you just made will be lost.
        </div>
        <div class="journal-modal-actions">
            <button type="button" class="modal-btn modal-btn-cancel" id="closeDiscardModalBtn">Keep Editing</button>
            <button type="button" class="modal-btn modal-btn-confirm" id="confirmDiscardBtn">Discard Changes</button>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const section = document.getElementById("feelingsSection");
            const tagFlowHeader = document.getElementById("tagFlowHeader");
            const closeDrawerBtn = document.getElementById("closeDrawerBtn");
            const checkboxes = document.querySelectorAll(".tag-checkbox");
            const summaryContainer = document.getElementById("tagsSummary");
            const form = document.getElementById("journalForm");
            const errorBlock = document.getElementById("topErrorBlock");

            // Modal Dom Elements
            const discardModal = document.getElementById("discardModal");
            const openModalBtn = document.getElementById("openDiscardModalBtn");
            const closeModalBtn = document.getElementById("closeDiscardModalBtn");
            const confirmDiscardBtn = document.getElementById("confirmDiscardBtn");

            // Tag Drawer Handling
            if(tagFlowHeader) {
                tagFlowHeader.addEventListener("click", function() {
                    section.classList.toggle("is-expanded");
                });
            }
            if(closeDrawerBtn) {
                closeDrawerBtn.addEventListener("click", function() {
                    section.classList.remove("is-expanded");
                });
            }

            // Real-Time Sticker Tracking Rendering
            checkboxes.forEach(box => {
                box.addEventListener("change", updateLiveBadges);
            });

            function updateLiveBadges() {
                summaryContainer.innerHTML = "";
                checkboxes.forEach(box => {
                    if(box.checked) {
                        const span = document.createElement("span");
                        span.className = "active-tag-badge";
                        span.innerText = box.getAttribute("data-tagname");
                        summaryContainer.appendChild(span);
                    }
                });
            }

            // RUN IMMEDIATELY ON LOAD: Renders stickers for saved feelings on launch
            updateLiveBadges();

            // Modal Action Pipeline
            openModalBtn.addEventListener("click", function() {
                discardModal.classList.add("is-active");
            });
            closeModalBtn.addEventListener("click", function() {
                discardModal.classList.remove("is-active");
            });
            confirmDiscardBtn.addEventListener("click", function() {
                window.location.href = '@Url.Action("Details", new { id = Model.Id })';
            });

            // Catching Client-side Errors instantly on Edit Submissions
            form.addEventListener("submit", function (e) {
                setTimeout(function () {
                    const errorMessages = [];
                    const titleInvalid = document.querySelector("[data-valmsg-for='Title']").classList.contains("field-validation-error");
                    const contentInvalid = document.querySelector("[data-valmsg-for='Content']").classList.contains("field-validation-error");

                    if (document.getElementById("Title").value.trim() === "" || titleInvalid) {
                        errorMessages.push("The Title field is required.");
                    }
                    if (document.getElementById("Content").value.trim() === "" || contentInvalid) {
                        errorMessages.push("The Content field is required.");
                    }

                    if (errorMessages.length > 0) {
                        let htmlOutput = "<ul>";
                        errorMessages.forEach(msg => { htmlOutput += `<li>${msg}</li>`; });
                        htmlOutput += "</ul>";
                        
                        document.getElementById("validationSummaryContainer").innerHTML = htmlOutput;
                        errorBlock.style.display = "block";
                        window.scrollTo({ top: 0, behavior: 'smooth' });
                    } else {
                        errorBlock.style.display = "none";
                    }
                }, 50);
            });
        });
    </script>
}