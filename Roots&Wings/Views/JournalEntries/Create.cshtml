@model Roots_Wings.Models.JournalEntry

@{
    ViewData["Title"] = "New Entry";
    var allTags = ViewBag.AllTags as List<Roots_Wings.Models.Tag> ?? new List<Roots_Wings.Models.Tag>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/journal.css" asp-append-version="true" />
}

<div class="mb-3">
    <a asp-action="Index" class="rw-back-link">← Back to Journal</a>
</div>

<div class="row justify-content-center">
    <div class="col-md-8">

        <form asp-action="Create" method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"
                 style="font-size: 0.85rem;">
            </div>

            <!-- The open page -->
            <div class="journal-page">

                <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 1.2rem;">
                    <span style="font-size: 0.72rem; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: #B5A898;">
                        @DateTime.Today.ToString("MMMM d, yyyy")
                    </span>
                    <span asp-validation-for="Title"
                          class="text-danger"
                          style="font-size: 0.8rem;">
                    </span>
                </div>

                <!-- Title -->
                <input asp-for="Title"
                       class="journal-title-input"
                       placeholder="Give this entry a title..." />

                <hr class="journal-divider" />

                <!-- Content -->
                <textarea asp-for="Content"
                          class="journal-content-area"
                          placeholder="What's on your mind today..."></textarea>

                <span asp-validation-for="Content"
                      class="text-danger"
                      style="font-size: 0.8rem;">
                </span>

            </div>

            <!-- Tags -->
            @if (allTags.Any())
            {
                <div class="mt-3 mb-4">
                    <span class="rw-section-label">How are you feeling?</span>
                    <div>
                        @foreach (var tag in allTags)
                        {
                            <span class="tag-option">
                                <!--
                                    The checkbox is hidden so that clicking the label toggles it.
                                    CSS :checked changes the pill style automatically.
                                    The name "selectedTagIds" matches the controller parameter.
                                -->
                                <input type="checkbox"
                                       name="selectedTagIds"
                                       value="@tag.Id"
                                       id="tag-@tag.Id" />
                                <label for="tag-@tag.Id">@tag.Name</label>
                            </span>
                        }
                    </div>
                </div>
            }

            <div class="d-flex gap-2">
                <button type="submit" class="btn-rw-primary">Save Entry</button>
                <a asp-action="Index" class="btn-rw-secondary">Discard</a>
            </div>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}