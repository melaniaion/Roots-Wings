@using Microsoft.AspNetCore.Http
@{
    // Get the current controller/action names to handle smart dynamic highlighting
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Roots & Wings</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Playfair+Display:ital,wght=0,500;0,600;0,700;1,400&family=Newsreader:opsz,wght=6..72,400;6..72,500&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Roots_Wings.styles.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
<body>

    <span class="nature n1">🌿</span>
    <span class="nature n2">🌸</span>
    <span class="nature n3">🍃</span>
    <span class="nature n4">🌼</span>
    <span class="nature n5">✨</span>

    <div class="app-workspace" id="appWorkspace">
        
        <aside class="app-sidebar-artisan">
            
            <div class="sidebar-brand-block">
                <a class="brand-link" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-butterfly">🦋</span>
                    <div class="brand-meta">
                        <span class="brand-title">Roots & Wings</span>
                        <span class="brand-tagline">A quiet place to reflect</span>
                    </div>
                </a>
            </div>

            <div class="sidebar-divider-label"><span>NAVIGATION</span></div>

            <nav class="sidebar-navigation">
                <ul class="nav-stack">
                    <li>
                        <a class="nav-item-artisan @(currentController == "Home" && currentAction == "Index" ? "active" : "")" 
                           asp-area="" asp-controller="Home" asp-action="Index">
     
                            <i class="bi bi-sun artisan-icon"></i>
                            <div class="nav-meta">
                                <span class="nav-title">Today</span>
                                <span class="nav-subtitle">Check-in & focus</span>
                            </div>
                        </a>
                    </li>
                    <li>
                        <a class="nav-item-artisan @(currentController == "TherapySessions" ? "active" : "")" 
                           asp-controller="TherapySessions" asp-action="Index">
                            
                            <i class="bi bi-calendar-event artisan-icon"></i>
                            <div class="nav-meta">
                                <span class="nav-title">Sessions</span>
                                <span class="nav-subtitle">Therapy & growth</span>
                            </div>
                        </a>
                    </li>
                    <li>
                        <a class="nav-item-artisan @(currentController == "JournalEntries" ? "active" : "")" 
                           asp-controller="JournalEntries" asp-action="Index">
                            <i class="bi bi-book artisan-icon"></i>
                            <div class="nav-meta">
                                <span class="nav-title">Journal</span>
                                <span class="nav-subtitle">Your thoughts</span>
                            </div>
                        </a>
                    </li>
                </ul>
            </nav>

            <div class="sidebar-user-anchor">
                <span class="artisan-sparkle s1">✨</span>
                <span class="artisan-sparkle s2">✦</span>
                <span class="artisan-sparkle s3">✨</span>
                <span class="artisan-sparkle s4">🔸</span>

                <span class="sidebar-leaf-deco-1">🍃</span>
                <span class="sidebar-leaf-deco-2">🌿</span>

                <partial name="_LoginPartial" />
            </div>

            <div class="sidebar-toggle-container">
                <button type="button" class="sidebar-toggle-trigger" id="sidebarToggle" aria-label="Toggle Menu">
                    <i class="bi bi-list"></i>
                </button>
            </div>

        </aside>

        <div class="app-viewport-canvas">
            <main role="main" class="canvas-content-scroll">
                <div class="container-fluid px-3 px-md-5 py-4">
                    @RenderBody()
                </div>
                
                <footer class="app-human-footer">
                    <div class="container-fluid text-center">
                        &copy; 2026 Roots & Wings · <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                    </div>
                </footer>
            </main>
        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const toggleBtn = document.getElementById("sidebarToggle");
            const appWorkspace = document.getElementById("appWorkspace");

            toggleBtn.addEventListener("click", function () {
                // Smooth layout toggling hook
                appWorkspace.classList.toggle("sidebar-collapsed");
                const isCollapsed = appWorkspace.classList.contains("sidebar-collapsed");
                localStorage.setItem("artisanSidebarState", isCollapsed ? "collapsed" : "expanded");
            });

            if (localStorage.getItem("artisanSidebarState") === "collapsed") {
                appWorkspace.classList.add("sidebar-collapsed");
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>