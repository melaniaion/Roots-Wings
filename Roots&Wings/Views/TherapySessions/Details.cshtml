@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Xsrf
@using Roots_Wings.Helpers
@model Roots_Wings.Models.TherapySession

@{
    ViewData["Title"] = Model.Title;

    var linkedEntries = ViewBag.LinkedEntries as List<Roots_Wings.Models.JournalEntry>
                        ?? new List<Roots_Wings.Models.JournalEntry>();
    int selectedRange = ViewBag.SelectedRangeDays ?? 7;
    bool hasPassed    = ViewBag.SessionHasPassed ?? false;

    // Countdown shown in the header pill
    var diff = (Model.SessionDate.Date - DateTime.Today).Days;
    string countdown = diff == 0 ? "Today"
                     : diff  > 0 ? $"In {diff} day{(diff == 1 ? "" : "s")}"
                                 : $"{-diff} day{(-diff == 1 ? "" : "s")} ago";
}

@section Styles {
    <link rel="stylesheet" href="~/css/sessions.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/prep-panel.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/prep-chat.css" asp-append-version="true" />
}

<div class="mb-3">
    <a asp-action="Index" class="rw-back-link">← Back to Sessions</a>
</div>

<!-- Session header -->
<div class="rw-card mb-3">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
        <div>
            <div class="session-header-date">
                @Model.SessionDate.ToLocal().ToString("dddd, MMMM d, yyyy · h:mm tt")
                @if (!string.IsNullOrEmpty(Model.TherapistName))
                {
                    <span style="margin-left: 0.4rem; color: #B5A898;">
                        · with @Model.TherapistName
                    </span>
                }
            </div>
            <h1 class="rw-page-title">@Model.Title</h1>
            <span class="therapy-type-pill">@TherapyTypeOptions.LabelFor(Model.TherapyType)</span>
        </div>

        <span class="countdown-pill @(hasPassed ? "status-past" : "status-upcoming")">
            @countdown
        </span>
    </div>
</div>

<!-- Prep and Post notes -->
<div class="row g-3 mb-3">

    <!-- Before the session -->
    <div class="col-md-6">
        <div class="rw-card h-100">
            <div class="notes-card-head">
                <span class="notes-label" style="margin: 0;">Before the session</span>
                <button type="button" class="notes-edit-pen"
                        data-rw-panel-open="prepPanel"
                        aria-label="Edit prep notes" title="Edit prep notes">
                    <i class="bi bi-pencil"></i>
                </button>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.PrepNotes))
            {
                <div class="notes-body-preview">@Model.PrepNotes</div>
            }
            else
            {
                <p class="notes-empty">No prep notes yet.</p>
            }
        </div>
    </div>

    <!-- After the session -->
    <div class="col-md-6">
        <div class="rw-card h-100">
            <div class="notes-card-head">
                <span class="notes-label" style="margin: 0;">After the session</span>
                @if (hasPassed)
                {
                    <button type="button" class="notes-edit-pen"
                            data-rw-panel-open="postPanel"
                            aria-label="Edit reflection" title="Edit reflection">
                        <i class="bi bi-pencil"></i>
                    </button>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.PostNotes))
            {
                <div class="notes-body-preview">@Model.PostNotes</div>
            }
            else if (hasPassed)
            {
                <p class="notes-empty">How did it go? Add a reflection.</p>
            }
            else
            {
                <p class="notes-empty">Available after the session.</p>
            }
        </div>
    </div>

</div>

<!-- Journal entries near this session -->
<div class="rw-card mb-3">

    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <span class="rw-section-label" style="margin: 0;">
            Journal entries around this date
        </span>

        @if (linkedEntries.Any())
        {
            <a asp-controller="TherapySessions"
               asp-action="SummariseConsent"
               asp-route-id="@Model.Id"
               asp-route-rangeDays="@selectedRange"
               class="btn-rw-primary"
               style="font-size: 0.82rem; padding: 0.45rem 1.2rem;">
                ✦ Summarise entries
            </a>
        }

        <form method="get" asp-action="Details" asp-route-id="@Model.Id">
            <select name="rangeDays" class="range-select" onchange="this.form.submit()">
                @if (selectedRange == 3)  { <option value="3" selected>± 3 days</option> }  else { <option value="3">± 3 days</option> }
                @if (selectedRange == 7)  { <option value="7" selected>± 1 week</option> }  else { <option value="7">± 1 week</option> }
                @if (selectedRange == 14) { <option value="14" selected>± 2 weeks</option> } else { <option value="14">± 2 weeks</option> }
                @if (selectedRange == 30) { <option value="30" selected>± 1 month</option> } else { <option value="30">± 1 month</option> }
            </select>
        </form>
    </div>

    @if (linkedEntries.Any())
    {
        foreach (var entry in linkedEntries)
        {
            <a asp-controller="JournalEntries"
               asp-action="Details"
               asp-route-id="@entry.Id"
               class="entry-link-card">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <div>
                        <div class="entry-card-date">
                            @entry.CreatedAt.ToLocal().ToString("MMM d, yyyy")
                        </div>
                        <p class="entry-card-title">@entry.Title</p>
                    </div>
                    <div class="d-flex flex-wrap gap-1 justify-content-end">
                        @foreach (var tag in entry.Tags)
                        {
                            <span class="entry-tag-pill">@tag.Name</span>
                        }
                    </div>
                </div>
            </a>
        }
    }
    else
    {
        <p style="color: #B5A898; font-size: 0.88rem; font-style: italic; margin: 0;">
            No journal entries found within this range.
        </p>
    }

</div>

<!-- Actions -->
<div class="d-flex gap-2 mb-4">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-rw-secondary">
        Edit Session
    </a>
    <button type="button" class="btn-rw-danger" data-rw-modal-open="deleteSession">
        Delete
    </button>
</div>


@* PREP NOTES PANEL *@
<div class="rw-panel-overlay" id="prepPanel">
    <div class="rw-panel-card">
        <form asp-action="SavePrepNotes" asp-route-id="@Model.Id" method="post"
              style="display:flex; flex-direction:column; height:100%; min-height:0;">
            @Html.AntiForgeryToken()

            <div class="rw-panel-header">
                <div class="rw-panel-header-left">
                    <button type="button" class="rw-panel-back is-hidden" id="prepPanelBack"
                            onclick="rwBackToWriting()">
                        ← Cancel
                    </button>
                    <div>
                        <span class="rw-panel-eyebrow">Before the session</span>
                        <h2 class="rw-panel-title">@Model.SessionDate.ToLocal().ToString("dddd, MMMM d")</h2>
                    </div>
                </div>
                <button type="button" class="rw-panel-close" id="prepPanelClose" aria-label="Close">×</button>
            </div>

            <div class="rw-panel-body">
                <!-- WRITING VIEW -->
                <div id="prepWritingView" style="display:flex; flex-direction:column; flex-grow:1; min-height:0;">
                    <p class="rw-panel-invite">What would you like to bring to this session?</p>

                    <textarea name="prepNotes" id="prepNotesArea"
                              class="rw-panel-textarea"
                              placeholder="Start writing whatever's on your mind…">@Model.PrepNotes</textarea>

                    @if (!hasPassed)
                    {
                        <button type="button" class="rw-assistant-invite" onclick="rwStartChat()">
                            <span class="rw-assistant-invite-icon">✦</span>
                            <span class="rw-assistant-invite-text">
                                <span class="rw-assistant-invite-title">Not sure where to start?</span>
                                <span class="rw-assistant-invite-sub">Reflect with the Roots &amp; Wings Assistant</span>
                            </span>
                        </button>
                    }
                </div>

                <!-- CHAT VIEW (hidden until the assistant is opened) -->
                <div id="prepChatView" class="rw-chat is-hidden">
                    <p class="rw-chat-notice">
                        Not a therapist. An assistant to help you find your words that can make mistakes. 
                    </p>
                    <div class="rw-chat-stream" id="rwChatStream"></div>
                    <div class="rw-chat-input">
                        <textarea id="rwChatInput" class="rw-chat-textarea" rows="1"
                                  placeholder="Type your reflection…"></textarea>
                        <button type="button" class="rw-chat-send" id="rwChatSend" aria-label="Send">→</button>
                    </div>
                </div>
            </div>

            <div class="rw-panel-footer" id="prepPanelFooter">
                <button type="submit" class="btn-rw-primary"
                        style="font-size:0.82rem; padding:0.45rem 1.2rem;">
                    Save
                </button>
            </div>
        </form>
    </div>
</div>


@* POST NOTES PANEL  *@
<div class="rw-panel-overlay" id="postPanel">
    <div class="rw-panel-card">
        <form asp-action="SavePostNotes" asp-route-id="@Model.Id" method="post"
              style="display:flex; flex-direction:column; height:100%; min-height:0;">
            @Html.AntiForgeryToken()

            <div class="rw-panel-header">
                <div>
                    <span class="rw-panel-eyebrow">After the session</span>
                    <h2 class="rw-panel-title">@Model.SessionDate.ToLocal().ToString("dddd, MMMM d")</h2>
                </div>
                <button type="button" class="rw-panel-close" id="postPanelClose" aria-label="Close">×</button>
            </div>

            <div class="rw-panel-body">
                <p class="rw-panel-invite">How did the session go?</p>
                <textarea name="postNotes" id="postNotesArea"
                          class="rw-panel-textarea"
                          placeholder="What came up, what you took away, anything you want to remember…">@Model.PostNotes</textarea>
            </div>

            <div class="rw-panel-footer">
                <button type="submit" class="btn-rw-primary"
                        style="font-size:0.82rem; padding:0.45rem 1.2rem;">
                    Save
                </button>
            </div>
        </form>
    </div>
</div>


@*  MODALS *@
<div class="rw-modal-overlay" id="deleteSession">
    <div class="rw-modal-card">
        <div class="rw-modal-title">Delete permanently?</div>
        <div class="rw-modal-text">Are you sure? This cannot be undone.</div>
        <div class="rw-modal-actions">
            <button type="button" class="rw-modal-btn rw-modal-btn-cancel" data-rw-modal-close>
                Keep
            </button>
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="rw-modal-btn rw-modal-btn-danger">Delete</button>
            </form>
        </div>
    </div>
</div>

<div class="rw-modal-overlay" id="discardPrepModal">
    <div class="rw-modal-card">
        <div class="rw-modal-title">Discard changes?</div>
        <div class="rw-modal-text">You have unsaved changes to your prep notes. Close without saving?</div>
        <div class="rw-modal-actions">
            <button type="button" class="rw-modal-btn rw-modal-btn-cancel" data-rw-modal-close>Keep writing</button>
            <button type="button" class="rw-modal-btn rw-modal-btn-confirm" id="confirmDiscardPrep">Discard</button>
        </div>
    </div>
</div>

<div class="rw-modal-overlay" id="discardPostModal">
    <div class="rw-modal-card">
        <div class="rw-modal-title">Discard changes?</div>
        <div class="rw-modal-text">You have unsaved changes to your reflection. Close without saving?</div>
        <div class="rw-modal-actions">
            <button type="button" class="rw-modal-btn rw-modal-btn-cancel" data-rw-modal-close>Keep writing</button>
            <button type="button" class="rw-modal-btn rw-modal-btn-confirm" id="confirmDiscardPost">Discard</button>
        </div>
    </div>
</div>


@section Scripts {
    <script src="~/js/rw-panel.js" asp-append-version="true"></script>

    <script>
        window.rwChatConfig = {
            sessionId: @Model.Id,
            endpoint: '@Url.Action("ReflectTurn", "TherapySessions")',
            antiforgeryToken: '@Xsrf.GetAndStoreTokens(Context).RequestToken'
        };
    </script>
    <script src="~/js/prep-chat.js" asp-append-version="true"></script>

    <script>
        // Discard confirm guard, shared by both note panels. If the textarea
        // changed, the X and backdrop route through a confirm modal.
        function wirePanelDiscard(panelId, closeId, textareaId, modalId, confirmId) {
            var panel = document.getElementById(panelId);
            var textarea = document.getElementById(textareaId);
            var closeX = document.getElementById(closeId);
            var discardModal = document.getElementById(modalId);
            var confirmDiscard = document.getElementById(confirmId);
            if (!panel || !textarea || !closeX) return;

            var originalValue = textarea.value;

            function closePanel() {
                panel.classList.remove('is-active');
                document.body.classList.remove('rw-panel-open');
            }

            function attemptClose() {
                if (textarea.value !== originalValue) {
                    discardModal.classList.add('is-active');
                    document.body.classList.add('rw-modal-open');
                } else {
                    closePanel();
                }
            }

            closeX.addEventListener('click', attemptClose);
            panel.addEventListener('click', function (e) {
                if (e.target === panel) attemptClose();
            });
            confirmDiscard.addEventListener('click', function () {
                discardModal.classList.remove('is-active');
                document.body.classList.remove('rw-modal-open');
                closePanel();
            });
        }

        wirePanelDiscard('prepPanel', 'prepPanelClose', 'prepNotesArea', 'discardPrepModal', 'confirmDiscardPrep');
        wirePanelDiscard('postPanel', 'postPanelClose', 'postNotesArea', 'discardPostModal', 'confirmDiscardPost');

        // Whenever the prep panel opens, it shows the writing view, not
        // a leftover chat from a previous time it was open.
        document.querySelectorAll('[data-rw-panel-open="prepPanel"]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                if (typeof window.rwResetToWriting === 'function') {
                    window.rwResetToWriting();
                }
            });
        });



        // If arriving from Today with ?openPrep=true, open the prep panel automatically.
        (function () {
            var params = new URLSearchParams(window.location.search);
            if (params.get('openPrep') === 'true') {
                var panel = document.getElementById('prepPanel');
                if (panel) {
                    if (typeof window.rwResetToWriting === 'function') {
                        window.rwResetToWriting();
                    }
                    panel.classList.add('is-active');
                    document.body.classList.add('rw-panel-open');
                    window.history.replaceState({}, '', window.location.pathname);
                }
            }
        })();
    </script>
}
