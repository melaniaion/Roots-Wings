@model Roots_Wings.Models.Goal
@{
    ViewData["Title"] = "Refine your intention";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/growth-board.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/growth-edit.css" asp-append-version="true" />
}

<!-- back link -->
<a asp-action="Details" asp-route-id="@Model.Id" class="ge-back"><i class="bi bi-arrow-left"></i> Back to this goal</a>

<div class="ge-page">

    <!-- HERO -->
    <div class="ge-hero">
        <svg class="ge-hero-vein" viewBox="0 0 190 190" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M180 12 C120 42 78 88 50 168" stroke="#7A9B6E" stroke-width="1.6" stroke-linecap="round" opacity="0.55"/>
            <path d="M150 28 C138 44 135 56 138 70" stroke="#7A9B6E" stroke-width="1.3" stroke-linecap="round" opacity="0.45"/>
            <path d="M126 48 C113 62 109 74 111 88" stroke="#7A9B6E" stroke-width="1.3" stroke-linecap="round" opacity="0.45"/>
        </svg>

        <span class="ge-eyebrow"><i class="bi bi-pencil"></i> Refining</span>
        <h1 class="ge-title">Reshape this goal</h1>
        <p class="ge-lede">Adjust the title or your purpose. Your goals should evolve whenever your path does.</p>
    </div>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="ge-form">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="ge-validation"></div>

        <section class="ge-card">
            <div class="ge-field">
                <label asp-for="Title" class="ge-label">Goal name</label>
                <input asp-for="Title" class="ge-input" maxlength="120" autocomplete="off"
                       placeholder="What are you growing?" />
                <span asp-validation-for="Title" class="ge-field-error"></span>
            </div>

            <div class="ge-field">
                <label asp-for="Motivation" class="ge-label">Your why</label>
                <textarea asp-for="Motivation" class="ge-input ge-textarea" maxlength="500" rows="3"
                          placeholder="The reason this matters to you."></textarea>
                <span asp-validation-for="Motivation" class="ge-field-error"></span>
                <span class="ge-hint">A quick reminder of why this matters.</span>
            </div>
        </section>

        <!-- Milestones live on the details page, matching the controller -->
        <div class="ge-note">
            <i class="bi bi-leaf"></i>
            <span>Need to change your steps? You can add, edit or check off milestones directly from the goal’s main page.</span>
        </div>

        <div class="ge-actions">
            <button type="button" class="ge-btn-ghost" data-rw-modal-open="cancelEditGoal">Cancel</button>
            <button type="submit" class="ge-btn-primary"> Save changes</button>
        </div>
    </form>
</div>

<div class="rw-modal-overlay" id="cancelEditGoal">
    <div class="rw-modal-card">
        <div class="rw-modal-title">Discard changes?</div>
        <div class="rw-modal-text">
            Any edits to this goal will be lost.
        </div>
        <div class="rw-modal-actions">
            <button type="button" class="rw-modal-btn rw-modal-btn-cancel" data-rw-modal-close>
                Keep editing
            </button>
            <a asp-action="Details" asp-route-id="@Model.Id"
                   class="rw-modal-btn rw-modal-btn-confirm" style="text-decoration: none;"> Discard
            </a>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
