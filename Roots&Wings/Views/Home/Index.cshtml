@{
    ViewData["Title"] = "Welcome";
    Layout = "_Layout";
}
@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<div class="hero">
    <div class="hero-eyebrow">Your therapy companion</div>
    <h1>Grow your <em>roots.</em><br />Spread your <em>wings.</em></h1>
    <p class="hero-sub">A gentle space to prepare for therapy, reflect between sessions, and watch yourself grow, one day at a time.</p>
    <div class="hero-btns">
        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <a asp-controller="Today" asp-action="Index" class="btn-primary-rw">Continue your journey</a>
        }
        else
        {
            <a asp-area="Identity" asp-page="/Account/Login" class="btn-primary-rw">Begin your journey</a>
        }
    </div>
</div>

<div class="tagline">"You already have roots. This is where you find your wings."</div>
