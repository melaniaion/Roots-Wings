@{
    ViewData["Title"] = "Welcome";
    Layout = "_Layout";
}
@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<div class="hero">
    <div class="hero-eyebrow">🌱 Your therapy companion</div>
    <h1>Grow your <em>roots.</em><br />Spread your <em>wings.</em></h1>
    <p class="hero-sub">A gentle space to prepare for therapy, reflect between sessions, and watch yourself grow, one day at a time.</p>
    <div class="hero-btns">
        <a asp-area="Identity" asp-page="/Account/Register" class="btn-primary-rw">Begin your journey</a>
        <a asp-controller="Home" asp-action="About" class="btn-secondary-rw">Learn more</a>
    </div>
</div>

<div class="cards">
    <div class="card-rw">
        <div class="card-icon">🗓️</div>
        <div class="card-title">Session prep</div>
        <div class="card-desc">Never show up to therapy not knowing what to say</div>
    </div>
    <div class="card-rw">
        <div class="card-icon">📚</div>
        <div class="card-title">Journal</div>
        <div class="card-desc">Guided prompts that help you actually reflect</div>
    </div>
    <div class="card-rw">
        <div class="card-icon">🪴</div>
        <div class="card-title">Growth board</div>
        <div class="card-desc">Goals, milestones and a shelf of wins that never disappears</div>
    </div>
    <div class="card-rw">
        <div class="card-icon">🪞</div>
        <div class="card-title">Patterns</div>
        <div class="card-desc">Discover what your data notices about you</div>
    </div>
</div>

<div class="tagline">"You already have roots. This is where you find your wings."</div>
