@{
    ViewData["Title"] = "Something went wrong";
}

<div class="ge-page" style="text-align: center; padding-top: 3rem;">
    <div class="rw-card" style="max-width: 480px; margin: 0 auto;">
        <h1 class="rw-page-title" style="margin-bottom: 1rem;">Something went wrong</h1>
        <p style="color: #8B7B6A; line-height: 1.7; margin-bottom: 1.8rem;">
            An unexpected error occurred on our side. Nothing you did is wrong,
            please try again in a moment.
        </p>
        <a asp-controller="Home" asp-action="Index" class="btn-rw-primary">
            Back to safety
        </a>
    </div>
</div>